# ─────────────────────────────────────────────────────────────
# LLM Providers
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...   # Optional

# Model selection (swap to claude-3-5-sonnet-20241022, gemini-pro, etc.)
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# ─────────────────────────────────────────────────────────────
# Qdrant Vector Database
# ─────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=hospital_docs
QDRANT_API_KEY=                # Leave blank for local dev

# ─────────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./hospital.db

# ─────────────────────────────────────────────────────────────
# LangSmith Observability (optional but recommended)
# ─────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_PROJECT=hospital-ai
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─────────────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
