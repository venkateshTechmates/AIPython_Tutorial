# Production environment variable TEMPLATE
# NEVER commit real values — use a secrets manager in production

ENVIRONMENT=production
DEBUG=false

# LLM — inject via secrets manager
OPENAI_API_KEY=REPLACE_WITH_SECRET
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/hospital_prod.db

# Qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=hospital_docs_prod

# LangSmith — inject via secrets manager
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=REPLACE_WITH_SECRET
LANGCHAIN_PROJECT=hospital-production

# Rate limiting (stricter in production)
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60

# CORS (restrict to known origins in production)
ALLOWED_ORIGINS=https://hospital.example.com

# Workers
WORKERS=4
